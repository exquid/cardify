# Frontend (Vite, read at build time). Set on Vercel/Netlify:
# WebSocket address of the table server. Leave unset for local development
# (the app then uses ws://<this host>:8787/ws).
VITE_SERVER_URL=wss://cardify-server.onrender.com/ws

# Table server (Render or any Node host):
# PORT=8787
# ALLOWED_ORIGINS=https://cardify-blue.vercel.app
